# Copy this file to config.yaml and fill in your API key
# DO NOT commit config.yaml to git

anthropic_api_key: your-api-key-here
translate_model: claude-3-haiku-20240307

# Teleport database configuration
# Add your database connections here for use with 'minitool db' commands
teleport:
  # Environment configurations for tsh login
  # Each environment has its own proxy and cluster for authentication
  environments:
    production:
      proxy: "general-prod.xxx.com:443"
      cluster: "general.xxx.prod.cdcinternal.com"
    staging:
      proxy: "general-staging.xxx.com:443"
      cluster: "general.xxx.staging.cdcinternal.com"

  databases:
    # Example PostgreSQL database (production)
    - name: prod-postgres                                      # Custom alias for this database
      description: Production database
      environment: production                                  # Environment for tsh login
      service_name: prod-xxx-20230724-rds-aurora-xxx-1-xxxx    # Teleport registered service name
      db_name: myapp                                           # Actual database name (--db-name)
      db_protocol: postgres                                    # postgres, mysql, mongodb, etc.
      db_user: admin                                           # Database user
      local_port: 5432                                         # Local port for proxy (0 for auto)
      labels:                                                  # Optional: Teleport labels
        env: prod
        team: backend

    # Example PostgreSQL database (staging)
    - name: staging-postgres
      description: Staging database
      environment: staging
      service_name: staging-xxx-20230724-rds-aurora-xxx-1
      db_name: myapp
      db_protocol: postgres
      db_user: admin
      local_port: 5433

# Usage:
#   minitool db list                      - List all configured databases and environments
#   minitool db proxy <db-name>           - Start proxy for DataGrip (smart session management)
#   minitool db proxy all                 - Start proxies for ALL databases across all environments
#   minitool db proxy all --env <env>     - Start proxies for all databases in specific environment
#   minitool db connect <db-name>         - Direct connect to database CLI
#   minitool db proxy <db-name> -p 5432   - Use specific local port (overrides config)
#
# Smart Session Management:
# - Reuses existing valid sessions (no unnecessary browser prompts)
# - Supports multiple environments simultaneously (e.g., prod + staging)
# - Only re-authenticates when session expires (<5 min remaining)
# - Automatically reads proxy and cluster from environment config
#
# Generated command format:
#   tsh login --proxy=<proxy> <cluster>
#   tsh proxy db <service_name> --proxy=<proxy> --cluster=<cluster> --db-user=<user> --db-name=<name> --port=<port>
